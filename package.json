{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "source": "public/index.html",
  "dependencies": {
    "attractive-design-tokens": "^0.2.8",
    "browserslist": "^4.28.8",
    "dotenv": "^10.0.0",
    "dotenv-expand": "^5.1.0",
    "express": "^4.22.2",
    "jest-resolve": "^27.5.1",
    "jest-watch-typeahead": "^1.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "styled-components": "^5.3.11",
    "tailwindcss": "^3.4.19"
  },
  "@parcel/transformer-css": {
    "drafts": {
      "customMedia": true
    }
  },
  "scripts": {
    "start": "parcel public/index.html",
    "build": "parcel build public/index.html",
    "test": "vitest run",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest",
    "analyze": "parcel build public/index.html --detailed-report 10",
    "predeploy": "npm run typecheck && npm run build",
    "deploy": "gh-pages -d dist",
    "prepare": "husky"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "@parcel/resolver-default": {
    "packageExports": true
  },
  "devDependencies": {
    "@csstools/postcss-global-data": "^4.0.0",
    "@eslint/json": "^2.0.1",
    "@parcel/config-default": "^2.16.4",
    "@parcel/packager-raw-url": "2.16.4",
    "@parcel/transformer-css": "^2.16.4",
    "@parcel/transformer-postcss": "^2.16.4",
    "@parcel/transformer-svg-jsx": "^2.16.4",
    "@parcel/transformer-webmanifest": "2.16.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/styled-components": "^5.1.36",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^6.15.0",
    "eslint-plugin-prettier": "^3.4.1",
    "eslint-plugin-react": "^7.37.5",
    "gh-pages": "^6.3.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jest-environment-jsdom": "30.5.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.2",
    "nano-staged": "^1.0.2",
    "nodemon": "^2.0.22",
    "parcel": "^2.16.4",
    "postcss": "^8.5.26",
    "postcss-custom-media": "^12.0.1",
    "prettier": "^2.8.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "typescript-plugin-css-modules": "^5.2.0",
    "vitest": "^5.0.3"
  },
  "nano-staged": {
    "*.{ts,tsx,js,jsx}": [
      "pnpm run lint:fix"
    ]
  }
}
