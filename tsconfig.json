{
  "compilerOptions": {
    "plugins": [{ "name": "typescript-plugin-css-modules" }],
    "paths": {
      "~/*": ["./*"]
    },
    "strict": true,
    "noImplicitAny": true,
    "target": "esnext",
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsxImportSource": "react",
    "allowJs": true,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "react",
      "react-dom",
      "vitest/globals"
    ]
  },
  "include": [
    "src/**/*",
    "src/custom.d.ts",
    "src/styled.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts"
  ]
}
